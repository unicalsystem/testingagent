# TestAgent — production environment. Copy to .env on the VPS (chmod 600) and fill in.
# Generate secrets with:  docker compose -f docker-compose.prod.yml run --rm --no-deps api python -m testpilot.cli generate-keys
# Never commit .env. Never put these values in frontend code.

# --- Application --------------------------------------------------------------
APP_ENV=production
PUBLIC_URL=https://testagent.coolaudit.com
ALLOWED_ORIGINS=https://testagent.coolaudit.com
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Host port (localhost only) the web container listens on; host nginx proxies to it.
WEB_PORT=8081

# --- Multi-tenancy (release 1.1) -------------------------------------------------
# Organization served by the legacy /api/... routes and old /projects links (release-1.0 data).
DEFAULT_TENANT_SLUG=unical
# Public organization registration on the landing page (each one still needs Super Admin approval).
REGISTRATION_ENABLED=true
REGISTRATIONS_PER_IP_PER_DAY=5
INVITATION_TTL_HOURS=72
# Organizations (slugs, comma separated) that may use ALLOWED_PRIVATE_TARGETS in addition to the default one.
PRIVATE_TARGET_TENANTS=

# --- PostgreSQL (application database) ---------------------------------------
POSTGRES_DB=testpilot
POSTGRES_USER=testpilot
POSTGRES_PASSWORD=__generate__
# Must use the same password as above. "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://testpilot:__same_as_POSTGRES_PASSWORD__@db:5432/testpilot

# --- Secrets -------------------------------------------------------------------
SESSION_SECRET=__generate_at_least_32_chars__
# Fernet key that encrypts project secrets (test-account passwords). Back it up separately:
# without it, stored project secrets cannot be decrypted.
CREDENTIAL_ENCRYPTION_KEY=__generate__

# --- Claude (optional; AI features are disabled when empty) -------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_SECONDS=90
CLAUDE_MAX_TOKENS=8000

# --- Evidence storage (inside containers; backed by the testpilot_evidence volume)
EVIDENCE_DIR=/data/evidence
CAPTURE_VIDEO=true
CAPTURE_TRACE=true
SCREENSHOT_MODE=each_step

# --- Worker and execution limits ---------------------------------------------
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=600
STEP_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
MAX_STEP_RETRIES=2
MAX_STEPS_PER_CASE=200
WORKER_POLL_SECONDS=2
STALE_RUN_MINUTES=5

# --- Target safety -------------------------------------------------------------
# Hosts allowed to resolve to private/internal addresses. Keep this to the bundled
# sample app unless you deliberately test an internal system. Metadata IPs stay blocked.
ALLOWED_PRIVATE_TARGETS=sample-app

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# MySQL report store credentials go in config.local (see config.local.example), not here.

# --- Mobile app testing (release 1.8) -------------------------------------------
# Device minutes run on each customer's own BrowserStack / LambdaTest / Sauce Labs / Appium account.
# Unical-hosted device lab (an Appium 2 hub reachable from the worker). Leave empty until it exists.
MOBILE_LAB_URL=
MOBILE_LAB_USER=
MOBILE_LAB_PASSWORD=
MOBILE_PARALLEL_RUNS=3
MOBILE_MAX_LIVE_SESSIONS=2
MOBILE_MAX_APP_MB=400
